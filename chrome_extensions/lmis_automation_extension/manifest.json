{
  "manifest_version": 3,
  "name": "LMIS Establishment Automation",
  "version": "1.0.0",
  "description": "Automate LMIS establishment creation from uploaded Word documents.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["https://lmis.labourmisessirfid.kp.gov.pk/*"],
  "action": {
    "default_title": "LMIS Automation",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://lmis.labourmisessirfid.kp.gov.pk/*"],
      "js": ["contentScript.js"],
      "run_at": "document_idle"
    }
  ]
}
